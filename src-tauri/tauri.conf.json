{
  "$schema": "https://raw.githubusercontent.com/nicedoc/open-code/refs/heads/main/schemas/json/tauri-conf.schema.json",
  "productName": "OpenCode-Monitor",
  "version": "1.5.4",
  "identifier": "com.opencode.monitor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenCode-Monitor",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' https://raw.githubusercontent.com https://github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/chandupahashen/opencode-monitor/releases/latest/download/update.json",
        "https://raw.githubusercontent.com/chandupahashen/opencode-monitor/main/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4NkRDRkZDQjRCOUU4ODAKUldTQTZMbTAvTTl0U1B6VHJEeVJkdmpmTW85UnJEMzd0WEJ5SHVpY1M4eU51TEtVajN6MEY0dk0K",
      "windows": {
        "installMode": "passive"
      },
      "dialog": false
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "msi",
    "icon": [
     "icons/32x32.png",
     "icons/128x128.png",
     "icons/128x128@2x.png",
     "icons/icon.ico"
   ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "copyright": "Copyright (c) 2025 OpenCode",
    "publisher": "OpenCode"
  }
}
